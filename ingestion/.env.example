# Direct download URL for the official DGCA city-pair / passenger-traffic
# CSV or Excel file. Leave empty until the exact file URL is known.
# Official listings (not necessarily direct file URLs):
#   https://www.dgca.gov.in/
#   https://www.data.gov.in/catalog/monthly-air-traffic-statistics
DGCA_SOURCE_URL=

# Basket size for TOP_N_BY_PASSENGERS. Do not assume a fixed 5-route basket.
TOP_N=10

# Optional override of the default ingestion/data directory.
# DATA_DIRECTORY=

# Optional period used in raw filenames and basket filtering (YYYY-MM).
# If omitted, the pipeline infers it from the file contents.
# DGCA_REFERENCE_PERIOD=2026-08

# HTTP timeout for DGCA downloads (seconds).
HTTP_TIMEOUT_SECONDS=60

# Optional explicit column names if auto-detection is not enough.
# DGCA_COL_ORIGIN_AIRPORT=
# DGCA_COL_DESTINATION_AIRPORT=
# DGCA_COL_PASSENGER_COUNT=
# DGCA_COL_REFERENCE_PERIOD=
# DGCA_COL_ORIGIN_CITY=
# DGCA_COL_DESTINATION_CITY=
